# ── Cashfree (server-side only — never expose SECRET_KEY to browser) ──
# Get from: Cashfree Dashboard → Settings → API Keys
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# SANDBOX for testing, PRODUCTION for live payments
CASHFREE_ENV=SANDBOX

# ── Razorpay ──────────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Server ────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Vite (frontend env — VITE_ prefix required) ───────────────
# Points the React app to the backend server
VITE_SERVER_URL=http://localhost:3001
# "sandbox" or "production"
VITE_CASHFREE_ENV=sandbox
